# Release Day Radar — environment template
# Copy to .env and fill in locally:  Copy-Item .env.example .env
# .env is git-ignored. Never commit real keys.

# --- YouTube Data API v3 ---------------------------------------------------
# Google Cloud Console -> enable "YouTube Data API v3" -> create an API key.
YOUTUBE_API_KEY=

# Public video used only to smoke-test key/quota in src/test_sources.py.
YOUTUBE_SMOKE_VIDEO_ID=dQw4w9WgXcQ

# --- TMDb API v3 -----------------------------------------------------------
# https://www.themoviedb.org/settings/api -> API Key (v3 auth).
TMDB_API_KEY=

# --- Optional sources ------------------------------------------------------
# OMDb is a fallback only; TMDb + YouTube cover the semi-structured shape.
OMDB_API_KEY=
